---
import type { Lang } from '../i18n/index';
import { paths } from '../data/site';

interface Props {
  lang: Lang;
  t: (key: string) => string;
}

const { lang, t } = Astro.props;
---

<footer class="site-footer">
  <span class="rights">{t('footer.rights-short')}</span>
  <!-- Mobile only: price note sits between the copyright and brand lines -->
  <span class="vat">{t('footer.vat')}</span>
  <span class="brand">
    {t('footer.brand-prefix')}
    <a href={t('footer.NÍTIDA-link')} target="_blank" rel="noopener">{t('footer.brand-name')}</a>
  </span>
  <!-- Legally required even though the mock omits it -->
  <a class="privacy" href={paths.privacy[lang]}>{t('footer.privacy')}</a>
</footer>

<style lang="scss">
  @use '../styles/tokens' as *;

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 28px;
    padding: 28px $gutter 32px;
    font: 500 12px/1.4 $font-mono;
    color: $muted-3;
    @include bp-mobile {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px $gutter-m 32px;
    }
  }
  .vat {
    display: none;
    @include bp-mobile {
      display: inline;
    }
  }
  .brand a {
    color: $nitida;
  }
  .privacy {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    @include hover-only {
      &:hover {
        color: $paper;
      }
    }
  }
  // Desktop order: © left, privacy middle, brand right
  .rights { order: 1; }
  .privacy { order: 2; margin-right: auto; }
  .brand { order: 3; }
  @include bp-mobile {
    .rights { order: 1; }
    .vat { order: 2; }
    .brand { order: 3; }
    .privacy { order: 4; margin-right: 0; }
  }
</style>
