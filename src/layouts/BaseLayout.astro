---
import '@picocss/pico/css/pico.min.css';
import '../styles/global.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Lang } from '../i18n/index';
import { baseSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** URL of the equivalent page in the other language */
  alternateLangUrl: string;
  /** Extra schema.org nodes for this page (e.g. a Service); org + website are always included */
  jsonLd?: object[];
}

const { title, description, lang, alternateLangUrl, jsonLd = [] } = Astro.props;
const t = useTranslations(lang);
const canonicalUrl = new URL(Astro.url.pathname, 'https://maumarketing.pt').href;
const altLang = lang === 'pt' ? 'en' : 'pt';
// Trailing slash so hreflang points at the other page's canonical URL
const alternateFull = new URL(alternateLangUrl.replace(/([^/])$/, '$1/'), 'https://maumarketing.pt').href;
const schema = { '@context': 'https://schema.org', '@graph': [...baseSchema(lang), ...jsonLd] };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Alternate language (hreflang must list the page itself too) -->
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={altLang} href={alternateFull} />
    <link rel="alternate" hreflang="x-default" href="https://maumarketing.pt/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_GB' : 'pt_PT'} />
    <meta property="og:site_name" content="MAU Marketing" />
    <!-- TODO: og:image / twitter:image once the new theme has a share image (1200×630 PNG) -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Sitemap and the plain-text summary for AI assistants -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800;900&family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&family=DM+Sans:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Sora:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Prevent Pico's dark mode from kicking in — we only ship light -->
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <Header lang={lang} alternateLangUrl={alternateLangUrl} t={t} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} t={t} />
  </body>
</html>
