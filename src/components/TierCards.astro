---
// Services section: MAU (lime hero card), MUITO MAU (lime outline), Auditoria (paper "inspection sheet").
// Mock: design/handoff/.../MAU Servicos.dc.html (1a/1b mobile, 1c desktop).
// Each card is ONE <a> to the tier page (no nested links); the "CTA" inside is a styled <span>.
// Prices come from pricing.ts via price.ts, never from i18n.
import { useTranslations, type Lang } from '../i18n/index';
import { pricing, tierPaths } from '../data/pricing';
import { eur, perMonth } from '../lib/price';
import AgentDemo from './AgentDemo.astro';

interface Props {
  lang: Lang;
  /** Heading tag: h1 on /servicos, h2 if the section is reused elsewhere */
  headingTag?: 'h1' | 'h2';
}
const { lang, headingTag = 'h1' } = Astro.props;
const t = useTranslations(lang);
const Heading = headingTag;
const mo = perMonth(lang);
const mauList = [1, 2, 3, 4, 5, 6].map((n) => t(`sv.mau.l${n}`));
const mmList = [1, 2, 3, 4, 5].map((n) => t(`sv.mm.l${n}`));
const sheetList = [1, 2, 3, 4].map((n) => t(`sv.in.l${n}`));
const gloss = t('sv.gloss');
---

<section class="tiers" aria-labelledby="tiers-h">
  <div class="head">
    <div>
      <Heading id="tiers-h" class="h">{t('sv.h.1')}<br class="br-d" /> <span class="lime">MAU</span> {t('sv.h.2')}</Heading>
      {gloss && <p class="gloss">{gloss}</p>}
    </div>
    <p class="vat">{t('sv.vat')}</p>
  </div>

  <div class="grid">
    <!-- MAU -->
    <a class="card card--mau" href={tierPaths.mau[lang]}>
      <span class="name">MAU</span>
      <span class="price">
        <span class="amount">{eur(pricing.mau.monthly, lang)}<small>{mo}</small></span>
        <span class="setup">+ {eur(pricing.mau.setup, lang)} {t('sv.setup')}</span>
        <span class="min min--d">{t('sv.min12')}</span>
      </span>
      <span class="tagline">{t('service.mau.problem')}</span>
      <span class="demo"><AgentDemo lang={lang} /></span>
      <ul class="checks">
        {mauList.map((l) => <li>{l}</li>)}
      </ul>
      <span class="foot">
        <span class="coffee">{t('service.mau.outcome')}</span>
        <span class="cta cta--ink">{t('sv.mau.cta')}<span class="chev" aria-hidden="true">›</span></span>
      </span>
      <span class="min min--m">{t('sv.min12.note')}</span>
    </a>

    <!-- MUITO MAU -->
    <a class="card card--mm" href={tierPaths['muito-mau'][lang]}>
      <span class="top">
        <span class="name">MUITO<br />MAU</span>
        <span class="price">
          <span class="amount">{eur(pricing['muito-mau'].monthly, lang)}<small>{mo}</small></span>
          <span class="setup">+ {eur(pricing['muito-mau'].setup, lang)} {t('sv.setup')}</span>
        </span>
      </span>
      <span class="tagline">{t('service.muito-mau.problem')}</span>
      <ul class="checks">
        <li class="lead">{t('sv.mm.lead')}</li>
        {mmList.map((l) => <li>{l}</li>)}
      </ul>
      <span class="cta cta--outline">{t('sv.mm.cta')}<span class="chev" aria-hidden="true">›</span></span>
    </a>

    <!-- Inspeção: paper sheet -->
    <a class="card card--sheet" href={tierPaths.inspecao[lang]}>
      <span class="id">
        <span class="sheetno">{t('sv.in.sheet')}</span>
        <span class="name">{t('service.inspecao.title')}</span>
        <span class="tagline">{t('service.inspecao.problem')}</span>
        <span class="price">
          <span class="amount">{eur(pricing.inspecao.once, lang)}</span> <small>{t('sv.once')}</small>
        </span>
      </span>
      <span class="list">
        <ul class="sheetlist">
          {sheetList.map((l) => <li><span>{l}</span><span class="box" aria-hidden="true">✓</span></li>)}
        </ul>
        <span class="sheetfoot">{t('sv.in.foot')}</span>
      </span>
      <span class="side">
        <span class="stamp" aria-hidden="true">{t('sv.in.stamp1')}<br />{t('sv.in.stamp2')}</span>
        <span class="cta cta--paper">{t('sv.in.cta')}<span class="chev" aria-hidden="true">›</span></span>
      </span>
    </a>
  </div>
  <p class="vat-m">{t('sv.vat')}</p>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;

  .tiers {
    @include gutter;
    padding-block: 88px 72px;
    @include bp-mobile {
      padding-inline: 12px; // cards sit 12px from the edge on mobile
      padding-block: 24px 4px;
    }
  }

  // ── Heading ──
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 44px;
    @include bp-mobile {
      padding-inline: 8px; // back to the 20px page gutter
      margin-bottom: 20px;
    }
  }
  .h {
    @include display-type(clamp(44px, 6.4vw, 92px), 0.88);
    @include bp-mobile {
      font-size: 44px;
      line-height: 0.92;
      letter-spacing: -0.04em;
    }
  }
  .br-d {
    @include bp-mobile {
      display: none;
    }
  }
  .lime {
    color: $lime;
  }
  .gloss {
    @include mono-label(12px, $muted-2);
    text-transform: none;
    letter-spacing: 0;
    margin-top: 10px;
  }
  .vat {
    font: 500 13px/1 $font-mono;
    color: $muted-2;
    padding-bottom: 8px;
    white-space: nowrap;
    @include bp-mobile {
      display: none; // mobile shows it at the bottom of the section (and in each card note)
    }
  }

  // ── Grid ──
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    @include bp-mobile {
      gap: 12px;
    }
    @media (min-width: 1000px) {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
  }
  .card {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
    &:focus-visible {
      outline: 2px solid $paper;
      outline-offset: 4px;
    }
  }
  small {
    font: 700 22px/1 $font-body;
    letter-spacing: 0;
  }

  // CTA pills (spans inside the card link)
  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: $r-pill;
    font: 700 15px/1 $font-body;
    white-space: nowrap;
    transition: gap 0.15s, margin 0.15s;
  }
  @include hover-only {
    .card:hover .cta {
      gap: 10px;
    }
  }
  .cta--ink {
    background: $ink;
    color: $lime;
    height: 56px;
    font-size: 16px;
    padding-inline: 36px;
  }
  .cta--outline {
    border: 1.5px solid $paper;
    height: 62px;
    font-size: 16px;
    margin-top: auto;
  }
  .cta--paper {
    background: $ink;
    color: $paper;
    height: 56px;
  }

  // ── MAU (filled lime hero) ──
  .card--mau {
    background: $lime;
    color: $ink;
    border-radius: $r-card-lg;
    padding: 40px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    align-content: start;
    grid-template-rows: auto auto auto 1fr auto; // the checklist row absorbs spare height next to the taller MUITO MAU card
    column-gap: 24px;
    @media (min-width: 1000px) {
      grid-row: span 1;
    }
    @include bp-mobile {
      grid-template-rows: none;
      border-radius: $r-card-lg-m;
      padding: 22px 18px 18px;
      column-gap: 10px;
    }

    .name {
      @include display-type(clamp(64px, 9.2vw, 132px), 0.78);
      letter-spacing: -0.055em;
      @include bp-mobile {
        font-size: 64px;
        line-height: 0.8;
        letter-spacing: -0.05em;
      }
    }
    .price {
      grid-column: 2;
      grid-row: 1 / span 2;
      text-align: right;
      @include bp-mobile {
        grid-row: 1;
      }
    }
    .amount {
      display: block;
      font: 400 clamp(44px, 6.7vw, 96px) / 0.85 $font-display;
      letter-spacing: -0.05em;
      white-space: nowrap;
      @include bp-mobile {
        font-size: 44px;
        line-height: 0.9;
        letter-spacing: -0.04em;
      }
    }
    small {
      font-size: 22px;
      @include bp-mobile {
        font-size: 16px;
      }
    }
    .setup {
      display: block;
      font: 700 15px/1.3 $font-body;
      margin-top: 10px;
      @include bp-mobile {
        font-weight: 600;
        font-size: 12px;
        margin-top: 6px;
      }
    }
    .min {
      font: 500 12px/1.3 $font-mono;
      color: $ink-muted-2;
    }
    .min--d {
      display: block;
      margin-top: 4px;
      @include bp-mobile {
        display: none;
      }
    }
    .min--m {
      display: none;
      @include bp-mobile {
        display: block;
        grid-column: 1 / -1;
        order: 6;
        font-size: 11px;
        color: $ink-muted;
        margin-top: 16px;
      }
    }
    .tagline {
      grid-column: 1;
      display: block;
      margin-top: 22px;
      max-width: 440px;
      font: 700 clamp(20px, 2vw, 26px) / 1.2 $font-body;
      letter-spacing: -0.015em;
      @include bp-mobile {
        grid-column: 1 / -1;
        margin-top: 16px;
        font-size: 19px;
        line-height: 1.25;
        letter-spacing: -0.01em;
        max-width: none;
      }
    }
    .demo {
      grid-column: 1 / -1;
      display: block;
      margin-top: 26px;
      @include bp-mobile {
        margin-top: 16px;
        order: 3;
      }
    }
    .checks {
      grid-column: 1 / -1;
      list-style: none;
      margin: 26px 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px 28px;
      font: 500 15px/1.35 $font-body;
      color: $ink; // Pico paints list items in the link colour (lime) inside <a>
      @include bp-mobile {
        order: 5;
        grid-template-columns: 1fr;
        gap: 8px;
        font-size: 14px;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid rgba(13, 13, 11, 0.2);
      }
      li {
        padding: 0;
        margin: 0;
        list-style: none;
        &::before {
          content: '✓ ';
        }
      }
    }
    .foot {
      grid-column: 1 / -1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
      margin-top: 26px;
      border-top: 1px solid rgba(13, 13, 11, 0.2);
      padding-top: 24px;
      @include bp-mobile {
        order: 4;
        flex-direction: column;
        align-items: stretch;
        gap: 16px;
        border-top: 0;
        padding-top: 0;
        margin-top: 16px;
      }
    }
    .coffee {
      font: 600 17px/1.35 $font-body;
      max-width: 14em; // wraps after "equipa." like the mock
      @include bp-mobile {
        font-weight: 500;
        font-size: 15px;
        line-height: 1.4;
        max-width: none;
      }
    }
    .foot .cta--ink {
      padding-inline: 36px;
      font-size: 17px;
      height: auto;
      padding-block: 22px;
      @include bp-mobile {
        height: 56px;
        padding: 0;
        font-size: 16px;
      }
    }
  }

  // ── MUITO MAU (lime outline) ──
  .card--mm {
    border: 1.5px solid $lime;
    border-radius: $r-card-lg;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    @include bp-mobile {
      border-radius: $r-card-lg-m;
      padding: 22px 18px 18px;
      gap: 14px;
    }
    .top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
    }
    .name {
      @include display-type(clamp(38px, 4.4vw, 64px), 0.82);
      letter-spacing: -0.05em;
      @include bp-mobile {
        font-size: 38px;
        line-height: 0.85;
      }
    }
    .price {
      text-align: right;
    }
    .amount {
      display: block;
      font: 400 clamp(36px, 4.2vw, 60px) / 0.85 $font-display;
      letter-spacing: -0.05em;
      color: $lime;
      white-space: nowrap;
      @include bp-mobile {
        font-size: 36px;
        line-height: 0.9;
      }
    }
    small {
      font-size: 18px;
      @include bp-mobile {
        font-size: 14px;
      }
    }
    .setup {
      display: block;
      margin-top: 10px;
      font: 600 14px/1.3 $font-body;
      color: rgba(242, 240, 233, 0.75);
      @include bp-mobile {
        font-size: 12px;
        margin-top: 6px;
      }
    }
    .tagline {
      display: block;
      font: 700 21px/1.3 $font-body;
      letter-spacing: -0.01em;
      @include bp-mobile {
        font-size: 17px;
      }
    }
    .checks {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 10px;
      font: 400 15px/1.35 $font-body;
      color: rgba(242, 240, 233, 0.82);
      @include bp-mobile {
        gap: 7px;
        font-size: 14px;
      }
      li {
        padding: 0;
        margin: 0;
        list-style: none;
        &:not(.lead)::before {
          content: '✓ ';
        }
      }
      .lead {
        font: 600 11px/1 $font-mono;
        color: $lime;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }
    }
    .cta--outline {
      @include bp-mobile {
        height: 52px;
        font-size: 15px;
      }
    }
    @include hover-only {
      &:hover {
        background: $lime;
        color: $ink;
        .amount,
        .lead {
          color: $ink;
        }
        .setup,
        .checks {
          color: $ink-muted;
        }
        .cta--outline {
          border-color: $ink;
        }
      }
    }
    &:focus-visible {
      background: $lime;
      color: $ink;
      .amount,
      .lead {
        color: $ink;
      }
      .setup,
      .checks {
        color: $ink-muted;
      }
      .cta--outline {
        border-color: $ink;
      }
    }
  }

  // ── Inspeção (paper sheet) ──
  .card--sheet {
    grid-column: 1 / -1;
    position: relative;
    overflow: hidden;
    background: $paper;
    color: $ink;
    border-radius: 10px;
    padding: 32px 40px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px 44px;
    align-items: center;
    @media (min-width: 1000px) {
      grid-template-columns: 330px minmax(0, 1fr) 230px;
    }
    @include bp-mobile {
      border-radius: 8px;
      padding: 20px 18px;
      gap: 0;
    }

    .sheetno {
      display: block;
      @include mono-label(10px, $ink-muted-2);
      letter-spacing: 0.14em;
      line-height: 1;
    }
    .name {
      display: block;
      @include display-type(40px, 1);
      letter-spacing: -0.045em;
      margin-top: 10px;
      @include bp-mobile {
        font-size: 28px;
        margin-top: 8px;
        letter-spacing: -0.04em;
      }
    }
    .tagline {
      display: block;
      font: 700 18px/1.3 $font-body;
      margin-top: 8px;
      @include bp-mobile {
        font-size: 16px;
        max-width: 250px;
      }
    }
    .price {
      display: block;
      margin-top: 14px;
      @include bp-mobile {
        margin-top: 12px;
      }
    }
    .amount {
      font: 400 40px/1 $font-display;
      letter-spacing: -0.045em;
      @include bp-mobile {
        font-size: 32px;
        letter-spacing: -0.04em;
      }
    }
    small {
      font: 600 14px/1 $font-body;
      @include bp-mobile {
        font-size: 13px;
      }
    }
    .list {
      display: block;
      @include bp-mobile {
        margin-top: 14px;
      }
    }
    .sheetlist {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid rgba(13, 13, 11, 0.25);
      display: grid;
      grid-template-columns: 1fr;
      column-gap: 28px;
      font: 500 14px/1.2 $font-body;
      @media (min-width: 1000px) {
        grid-template-columns: 1fr 1fr;
      }
      @include bp-mobile {
        font-size: 13px;
        border-top-color: rgba(13, 13, 11, 0.2);
      }
      li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 11px 0;
        margin: 0;
        list-style: none;
        color: $ink;
        border-bottom: 1px solid rgba(13, 13, 11, 0.14);
        @include bp-mobile {
          padding: 8px 0;
          border-bottom-color: rgba(13, 13, 11, 0.12);
        }
      }
    }
    .box {
      flex: none;
      width: 18px;
      height: 18px;
      border: 1.5px solid $ink;
      display: flex;
      align-items: center;
      justify-content: center;
      font: 800 12px/1 $font-body;
      @include bp-mobile {
        width: 16px;
        height: 16px;
        font-size: 11px;
      }
    }
    .sheetfoot {
      display: block;
      margin-top: 12px;
      font: 500 12px/1.4 $font-mono;
      color: $ink-muted-2;
      @include bp-mobile {
        font-size: 11px;
        margin: 10px 0 14px;
      }
    }
    .side {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
      @include bp-mobile {
        gap: 0;
      }
    }
    // Stamp: decorative, rotated, red double border (the red is used on this card only)
    .stamp {
      align-self: center;
      transform: rotate(-12deg);
      border: 4px double $stamp;
      color: $stamp;
      border-radius: 8px;
      padding: 10px 16px;
      font: 700 15px/1.1 $font-mono;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      @include bp-mobile {
        // .side is not positioned, so this anchors to the sheet's top-right corner
        position: absolute;
        right: -6px;
        top: 14px;
        transform: rotate(-14deg);
        border-width: 3px;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 12px;
        letter-spacing: 0.06em;
      }
    }
    .cta--paper {
      @include bp-mobile {
        height: 52px;
      }
    }
  }

  // Mobile only: "Preços sem IVA." under the cards (desktop shows it next to the heading)
  .vat-m {
    display: none;
    @include bp-mobile {
      display: block;
      font: 500 11px/1 $font-mono;
      color: $muted-3;
      padding: 16px 8px 24px;
    }
  }
</style>
