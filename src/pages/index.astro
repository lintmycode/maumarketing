---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import PlanStrip from '../components/PlanStrip.astro';
import TalkBand from '../components/TalkBand.astro';
import { useTranslations } from '../i18n/index';

const lang = 'pt';
const t = useTranslations(lang);
---

<BaseLayout
  title="MAU Marketing — Site, Google e Agente desde 49€/mês"
  description="Nem todo o marketing é MAU. Mas devia. Site, Google Business e um agente que actualiza o site por mensagem, desde 49€/mês."
  lang={lang}
  alternateLangUrl="/en/"
>
  <!-- Above the fold = one viewport: nav (outside <main>) + hero + plan strip -->
  <div class="fold">
    <HomeHero lang={lang} t={t} />
    <PlanStrip lang={lang} t={t} />
  </div>
  <TalkBand lang={lang} t={t} />
</BaseLayout>

<style lang="scss">
  // --header-h = rendered Header height (28px*2 padding + 40px CTA pill; 18*2 + 44 on mobile).
  // min-height (not height) so short screens scroll instead of overlapping.
  .fold {
    --header-h: 96px;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    @media (max-width: 720px) {
      --header-h: 80px;
    }
  }
</style>
