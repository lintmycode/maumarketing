---
// Redesign contact card: name / email / message, own validation, EmailJS send from the browser.
import type { Lang } from '../i18n/index';
import { useTranslations } from '../i18n/index';
import { EMAIL, paths } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="panel" id="contact-panel">
  <div>
    <h2>{t('contactx.card-title')}</h2>
    <p class="sub">{t('contactx.card-sub')}</p>
  </div>

  <form id="contact-form" novalidate data-required={t('contactx.err-required')} data-invalid-email={t('contactx.err-email')} data-sending={t('contactx.sending')} data-send-error={t('contactx.send-error')}>
    <!-- Honeypot: bots fill it, humans don't (kept from the old form) -->
    <label style="display:none" aria-hidden="true">
      Do not fill this out
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
    <!-- Fields the EmailJS template may still reference (old form had them); sent empty/default -->
    <input type="hidden" name="website" value="" />
    <input type="hidden" name="subject" value={lang === 'pt' ? 'Contacto pelo site' : 'Contact from the site'} />

    <div class="row">
      <label class="field">
        <span class="lbl">{t('contactx.f-name')}</span>
        <input id="cf-name" name="name" type="text" autocomplete="name" placeholder={t('contactx.f-name-ph')} aria-describedby="cf-name-err" />
        <span class="err" id="cf-name-err" hidden></span>
      </label>
      <label class="field">
        <span class="lbl">{t('contactx.f-email')}</span>
        <input id="cf-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder={t('contactx.f-email-ph')} aria-describedby="cf-email-err" />
        <span class="err" id="cf-email-err" hidden></span>
      </label>
    </div>

    <label class="field">
      <span class="lbl">{t('contactx.f-msg')}</span>
      <textarea id="contact-message" name="message" rows="4" placeholder={t('contactx.f-msg-ph')} aria-describedby="cf-message-err"></textarea>
      <span class="err" id="cf-message-err" hidden></span>
    </label>

    <p class="send-error" id="cf-send-error" role="alert" hidden>
      <span></span> <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </p>

    <div class="foot">
      <span class="note">{t('contactx.note-before')}<a href={paths.privacy[lang]}>{t('contactx.note-link')}</a>{t('contactx.note-after')}</span>
      <button type="submit" class="btn btn--primary" id="cf-submit" data-label={t('contactx.submit')}>
        <span class="lab">{t('contactx.submit')}</span><span class="chev" aria-hidden="true">›</span>
      </button>
    </div>
  </form>

  <p class="sent" id="cf-sent" role="status" hidden>{t('contactx.sent')}</p>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
<script>
  // Same EmailJS account/template as the old ContactForm.astro
  const EMAILJS_PUBLIC_KEY = '35n5lDzpu_p_TvSBF';
  const EMAILJS_SERVICE_ID = 'service_wcvn6c8';
  const EMAILJS_TEMPLATE_ID = 'template_3kfyjva';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const btn = document.getElementById('cf-submit') as HTMLButtonElement;
    const lab = btn.querySelector('.lab') as HTMLElement;
    const sent = document.getElementById('cf-sent') as HTMLElement;
    const sendErr = document.getElementById('cf-send-error') as HTMLElement;
    const fields = ['name', 'email', 'message'].map((k) => ({
      key: k,
      el: document.getElementById(k === 'message' ? 'contact-message' : `cf-${k}`) as HTMLInputElement | HTMLTextAreaElement,
      err: document.getElementById(`cf-${k}-err`) as HTMLElement,
    }));
    let submitted = false; // live (on-blur) validation only starts after the first submit

    const check = (f: (typeof fields)[number]): boolean => {
      const v = f.el.value.trim();
      let msg = '';
      if (!v) msg = form.dataset.required!;
      else if (f.key === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)) msg = form.dataset.invalidEmail!;
      f.err.textContent = msg;
      f.err.hidden = !msg;
      if (msg) f.el.setAttribute('aria-invalid', 'true');
      else f.el.removeAttribute('aria-invalid');
      return !msg;
    };
    fields.forEach((f) => {
      f.el.addEventListener('blur', () => submitted && check(f));
      f.el.addEventListener('input', () => submitted && check(f));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitted = true;
      const results = fields.map((f) => ({ f, ok: check(f) }));
      const firstBad = results.find((r) => !r.ok);
      if (firstBad) return firstBad.f.el.focus();
      if (btn.disabled) return;

      sendErr.hidden = true;
      btn.disabled = true;
      lab.textContent = form.dataset.sending!;
      try {
        const honeypot = (form.elements.namedItem('bot-field') as HTMLInputElement).value;
        if (!honeypot) {
          const emailjs = (window as any).emailjs;
          if (!emailjs) throw new Error('emailjs not loaded');
          emailjs.init(EMAILJS_PUBLIC_KEY);
          const res = await emailjs.sendForm(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, form);
          if (res.status !== 200) throw new Error('EmailJS failed');
        } // bots get the same "sent" screen without anything being sent
        form.hidden = true;
        sent.hidden = false;
        sent.setAttribute('tabindex', '-1');
        sent.focus();
      } catch (err) {
        console.error('EmailJS error:', err);
        (sendErr.firstElementChild as HTMLElement).textContent = form.dataset.sendError!;
        sendErr.hidden = false;
        btn.disabled = false;
        lab.textContent = btn.dataset.label!;
      }
    });
  }
</script>

<style lang="scss">
  @use '../styles/tokens' as *;

  [hidden] {
    display: none !important; // author display rules below would otherwise beat the attribute
  }
  .panel {
    border: 1.5px solid $lime;
    border-radius: $r-card-lg;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 26px;
    @include bp-mobile {
      border-radius: $r-card-lg-m;
      padding: 24px 18px;
      gap: 20px;
    }
  }
  h2 {
    @include display-type(36px, 1);
    letter-spacing: -0.04em;
    margin: 0;
    @include bp-mobile {
      font-size: 28px;
    }
  }
  .sub {
    margin: 10px 0 0;
    font: 500 15px/1.4 $font-body;
    color: rgba(242, 240, 233, 0.6);
    @include bp-mobile {
      margin-top: 8px;
      font-size: 14px;
    }
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 26px;
    @include bp-mobile {
      gap: 20px;
    }
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    @include bp-mobile {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  .field {
    display: grid;
    gap: 8px;
    margin: 0;
    align-content: start;
  }
  .lbl {
    @include mono-label(11px, $muted-2);
    line-height: 1;
  }
  textarea {
    resize: none;
    margin: 0;
  }
  input {
    margin: 0;
  }
  // Invalid fields keep the standard border; the lime mono message below is the cue
  .err {
    font: 500 12px/1.3 $font-mono;
    color: $lime;
  }
  .send-error {
    margin: 0;
    font: 500 12px/1.5 $font-mono;
    color: $lime;
    a {
      color: inherit;
      text-decoration: underline;
    }
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    @include bp-mobile {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 14px;
      .btn {
        width: 100%;
        height: 56px;
        padding: 0 20px;
      }
    }
  }
  .foot .btn {
    width: auto; // Pico makes form buttons full-width
    margin: 0;
    flex: none;
  }
  .note {
    flex: 1;
    font: 500 12px/1.4 $font-mono;
    color: $muted-3;
    @include bp-mobile {
      font-size: 11px;
    }
    a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 3px;
      &:hover {
        color: $lime;
      }
    }
  }
  .btn[disabled] {
    opacity: 0.6;
    cursor: default;
  }
  .sent {
    margin: 0;
    @include display-type(28px, 1);
    color: $lime;
  }
</style>
