---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTABlock from '../../components/CTABlock.astro';
import { useTranslations } from '../../i18n/index';

const lang = 'pt';
const t = useTranslations(lang);
---

<BaseLayout
  title={t('services-page.title')}
  description={t('services-page.description')}
  lang={lang}
  alternateLangUrl="/en/services/"
>
  <div class="page-hero">
    <div class="container">
      <h1>{t('services-page.heading')}</h1>
      <p>{t('services-page.subheading')}</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <p style="font-size: 1.0625rem; color: var(--mau-muted); max-width: 540px; margin-bottom: 3rem;">
        {t('services-page.intro')}
      </p>
      <div class="service-grid">
        <ServiceCard
          title={t('service.sites.title')}
          problem={t('service.sites.problem')}
          outcome={t('service.sites.outcome')}
          price={t('service.sites.price')}
          href={t('service.sites.href')}
          ctaLabel={t('service.cta')}
        />
        <ServiceCard
          title={t('service.care.title')}
          problem={t('service.care.problem')}
          outcome={t('service.care.outcome')}
          price={t('service.care.price')}
          href={t('service.care.href')}
          ctaLabel={t('service.cta')}
        />
        <ServiceCard
          title={t('service.audit.title')}
          problem={t('service.audit.problem')}
          outcome={t('service.audit.outcome')}
          price={t('service.audit.price')}
          href={t('service.audit.href')}
          ctaLabel={t('service.cta')}
        />
      </div>
    </div>
  </section>

  <CTABlock
    heading={t('cta.default.heading')}
    body={t('cta.default.body')}
    buttonLabel={t('cta.default.button')}
    buttonHref="/contacto"
  />
</BaseLayout>
