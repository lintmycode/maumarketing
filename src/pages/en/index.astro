---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../../components/HomeHero.astro';
import PlanStrip from '../../components/PlanStrip.astro';
import TalkBand from '../../components/TalkBand.astro';
import { useTranslations } from '../../i18n/index';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout
  title="MAU Marketing — Website, Google and an Agent from €49/month"
  description="Not all marketing is MAU. But it should be. A website, Google Business and an agent that updates your site by message, from €49/month."
  lang={lang}
  alternateLangUrl="/"
>
  <!-- Above the fold = one viewport: nav (outside <main>) + hero + plan strip -->
  <div class="fold">
    <HomeHero lang={lang} t={t} />
    <PlanStrip lang={lang} t={t} />
  </div>
  <TalkBand lang={lang} t={t} />
</BaseLayout>

<style lang="scss">
  // --header-h = rendered Header height (28px*2 padding + 40px CTA pill; 18*2 + 44 on mobile).
  // min-height (not height) so short screens scroll instead of overlapping.
  .fold {
    --header-h: 96px;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    @media (max-width: 720px) {
      --header-h: 80px;
    }
  }
</style>
