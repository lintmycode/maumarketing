---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TierDetail from '../../components/TierDetail.astro';
import { useTranslations } from '../../i18n/index';
import { serviceSchema } from '../../lib/schema';
import { tierPaths } from '../../data/pricing';

const lang = 'pt';
const t = useTranslations(lang);
---

<BaseLayout
  title={t('muito-mau-page.title')}
  description={t('muito-mau-page.description')}
  lang={lang}
  jsonLd={[serviceSchema('muito-mau', lang)]}
  alternateLangUrl={tierPaths['muito-mau'].en}
>
  <TierDetail tier="muito-mau" lang={lang} />
</BaseLayout>
