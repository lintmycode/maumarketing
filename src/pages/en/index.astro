---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import CTABlock from '../../components/CTABlock.astro';
import { useTranslations } from '../../i18n/index';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout
  title="MAU Marketing — Websites, Monthly Plan and SEO for Small Businesses"
  description="Not all marketing is MAU. Websites from €399, a monthly plan with an agent you can text to update your site, and an SEO audit with Google setup. Fixed prices."
  lang={lang}
  alternateLangUrl="/"
>
  <!-- Hero -->
  <Hero t={t} lang={lang} />

  <!-- Services block -->
  <section class="section section--surface">
    <div class="container">
      <h2 class="section-heading">{t('home.services.heading')}</h2>
      <p class="section-subheading">{t('home.services.subheading')}</p>
      <div class="service-grid">
        <ServiceCard
          title={t('service.sites.title')}
          problem={t('service.sites.problem')}
          outcome={t('service.sites.outcome')}
          price={t('service.sites.price')}
          href={t('service.sites.href')}
          ctaLabel={t('service.cta')}
        />
        <ServiceCard
          title={t('service.care.title')}
          problem={t('service.care.problem')}
          outcome={t('service.care.outcome')}
          price={t('service.care.price')}
          href={t('service.care.href')}
          ctaLabel={t('service.cta')}
        />
        <ServiceCard
          title={t('service.audit.title')}
          problem={t('service.audit.problem')}
          outcome={t('service.audit.outcome')}
          price={t('service.audit.price')}
          href={t('service.audit.href')}
          ctaLabel={t('service.cta')}
        />
      </div>
    </div>
  </section>

  <!-- AI + Human block -->
  <section class="section">
    <div class="container">
      <div class="ai-block">
        <h2>{t('home.ai.heading')}</h2>
        <p>{t('home.ai.body')}</p>
      </div>
    </div>
  </section>

  <!-- Process preview -->
  <ProcessSteps t={t} />

  <!-- Trust / NÍTIDA block -->
  <section class="section section--surface">
    <div class="container">
      <h2 class="section-heading">{t('home.trust.heading')}</h2>
      <p style="max-width: 580px; font-size: 1.0625rem; line-height: 1.7; color: var(--mau-muted);">
        {t('home.trust.body')}
      </p>
      <a
        href={t('home.trust.NÍTIDA-url')}
        class="btn btn--secondary"
        style="margin-top: 1.5rem;"
        target="_blank"
        rel="noopener"
      >
        {t('home.trust.NÍTIDA')}
      </a>
    </div>
  </section>

  <!-- CTA block -->
  <CTABlock
    heading={t('home.cta.heading')}
    body={t('home.cta.body')}
    buttonLabel={t('home.cta.button')}
    buttonHref="/en/contact"
  />
</BaseLayout>
