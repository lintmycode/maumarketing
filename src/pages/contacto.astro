---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
import { useTranslations } from '../i18n/index';
import { EMAIL } from '../data/site';

const lang = 'pt';
const t = useTranslations(lang);
---

<BaseLayout
  title={t('contactx.title')}
  description={t('contactx.description')}
  lang={lang}
  alternateLangUrl="/en/contact"
>
  <main class="contact">
    <div class="left" id="falar">
      <h1>{t('contactx.h1')}<span class="q">?</span></h1>
      <p class="intro">{t('contactx.intro')}</p>

      <!-- Desktop: hairline rows -->
      <div class="rows">
        <div class="item">
          <div>
            <div class="lbl">{t('contactx.call-label')}</div>
            <div class="val">{t('contactx.call-title')}</div>
          </div>
          <button type="button" class="btn btn--primary" data-book data-prefill={t('contactx.call-prefill')}>{t('contactx.call-cta')}<span class="chev" aria-hidden="true">›</span></button>
        </div>
        <div class="item">
          <div>
            <div class="lbl">{t('contactx.email-label')}</div>
            <div class="val"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></div>
          </div>
          <a class="btn btn--secondary" href={`mailto:${EMAIL}`} data-copy={EMAIL} data-copied={t('contactx.copied')}><span class="copy-label">{t('contactx.copy')}</span><span class="chev" aria-hidden="true">›</span></a>
        </div>
      </div>

      <!-- Mobile: stacked buttons -->
      <div class="stack">
        <button type="button" class="btn btn--primary btn--block" data-book data-prefill={t('contactx.call-prefill')}>{t('contactx.call-cta-mobile')}<span class="chev" aria-hidden="true">›</span></button>
        <a class="btn btn--secondary btn--block" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>
    </div>

    <ContactPanel lang={lang} />
  </main>
</BaseLayout>

<script>
  // "Escolher hora": no booking tool, so scroll to the form, focus the message and prefill it if empty.
  document.querySelectorAll<HTMLElement>('[data-book]').forEach((b) => {
    b.addEventListener('click', () => {
      const msg = document.getElementById('contact-message') as HTMLTextAreaElement | null;
      if (!msg) return;
      if (!msg.value.trim()) msg.value = b.dataset.prefill ?? '';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.getElementById('contact-panel')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
      msg.focus({ preventScroll: true });
      msg.setSelectionRange(msg.value.length, msg.value.length);
    });
  });

  // "Copiar": Clipboard API; without it the link's default mailto: runs.
  document.querySelectorAll<HTMLAnchorElement>('[data-copy]').forEach((a) => {
    a.addEventListener('click', async (e) => {
      if (!navigator.clipboard?.writeText) return;
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(a.dataset.copy!);
      } catch {
        location.href = a.href;
        return;
      }
      const label = a.querySelector('.copy-label') as HTMLElement;
      const original = label.textContent;
      label.textContent = a.dataset.copied!;
      setTimeout(() => (label.textContent = original), 2000);
    });
  });
</script>

<style lang="scss">
  @use '../styles/tokens' as *;

  .contact {
    max-width: 1440px;
    margin: 0 auto;
    @include gutter;
    padding-block: 72px 96px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 72px;
    align-items: start;
    @include bp-mobile {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-block: 28px 12px;
    }
  }
  h1 {
    @include display-type(108px, 0.9);
    margin: 0;
    @include bp-mobile {
      font-size: 58px;
      line-height: 0.95;
    }
  }
  .q {
    color: $lime;
  }
  .intro {
    margin: 28px 0 0;
    max-width: 440px;
    font: 500 20px/1.45 $font-body;
    color: $muted;
    text-wrap: pretty;
    @include bp-mobile {
      margin-top: 16px;
      font-size: 16px;
    }
  }
  .rows {
    margin-top: 48px;
    border-top: 1px solid $hairline;
    @include bp-mobile {
      display: none;
    }
  }
  .item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 24px 0;
    border-bottom: 1px solid $hairline;
    .btn {
      padding: 18px 28px;
      font-size: 15px;
    }
  }
  .lbl {
    @include mono-label(11px, $muted-2);
    letter-spacing: 0.12em;
    line-height: 1;
    margin-bottom: 10px;
  }
  .val {
    font: 700 26px/1.1 $font-body;
    letter-spacing: -0.02em;
    a {
      color: inherit;
      text-decoration: none;
    }
  }
  .stack {
    display: none;
    @include bp-mobile {
      display: grid;
      gap: 10px;
      margin-top: 28px;
    }
  }
</style>
